# ── Service ───────────────────────────────────────────────────────────────────
INTERFACE_ENV=development
INTERFACE_SERVICE_NAME=bzy-interface
INTERFACE_LOG_LEVEL=debug
INTERFACE_LOG_FORMAT=console

# ── HTTP server ───────────────────────────────────────────────────────────────
INTERFACE_HTTP_ADDR=:8080
INTERFACE_HTTP_READ_TIMEOUT=30s
INTERFACE_HTTP_WRITE_TIMEOUT=60s
INTERFACE_HTTP_SHUTDOWN_TIMEOUT=15s
INTERFACE_HTTP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
INTERFACE_AUTH_JWT_SECRET=change-me-use-a-long-random-secret-in-production
INTERFACE_AUTH_JWT_EXPIRY=24h
INTERFACE_AUTH_REFRESH_EXPIRY=168h     # 7 days
INTERFACE_AUTH_API_KEY_HEADER=X-API-Key

# ── Redis ─────────────────────────────────────────────────────────────────────
INTERFACE_REDIS_ADDR=localhost:6379
INTERFACE_REDIS_PASSWORD=
INTERFACE_REDIS_DB=2

# ── NATS ──────────────────────────────────────────────────────────────────────
INTERFACE_NATS_URL=nats://localhost:4222

# ── Upstream gRPC services ────────────────────────────────────────────────────
INTERFACE_GATEWAY_BRAIN_ADDR=localhost:50051
INTERFACE_GATEWAY_RUNNER_ADDR=localhost:50052

# ── Rate limiting ─────────────────────────────────────────────────────────────
INTERFACE_RATE_LIMIT_REQUESTS_PER_MIN=120
INTERFACE_RATE_LIMIT_BURST_SIZE=20

# ── Telemetry ─────────────────────────────────────────────────────────────────
INTERFACE_TELEMETRY_ENABLED=false
INTERFACE_TELEMETRY_OTLP_ENDPOINT=localhost:4317
INTERFACE_TELEMETRY_SAMPLE_RATE=1.0
