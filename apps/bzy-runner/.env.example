# ── Service ───────────────────────────────────────────────────────────────────
RUNNER_ENV=development
RUNNER_SERVICE_NAME=bzy-runner
RUNNER_LOG_LEVEL=debug
RUNNER_LOG_FORMAT=console

# ── Database ──────────────────────────────────────────────────────────────────
RUNNER_DATABASE_DSN=postgres://bzy:bzy_dev@localhost:5432/bzy_runner?sslmode=disable
RUNNER_DATABASE_MAX_OPEN_CONNS=10
RUNNER_DATABASE_MAX_IDLE_CONNS=3
RUNNER_DATABASE_CONN_MAX_LIFETIME=5m
RUNNER_DATABASE_MIGRATIONS_PATH=../../migrations/runner

# ── Redis ─────────────────────────────────────────────────────────────────────
RUNNER_REDIS_ADDR=localhost:6379
RUNNER_REDIS_PASSWORD=
RUNNER_REDIS_DB=1
RUNNER_REDIS_POOL_SIZE=10

# ── NATS ──────────────────────────────────────────────────────────────────────
RUNNER_NATS_URL=nats://localhost:4222
RUNNER_NATS_MAX_RECONNECT=10
RUNNER_NATS_RECONNECT_WAIT=2s

# ── Worker pool ───────────────────────────────────────────────────────────────
RUNNER_WORKER_CONCURRENCY=4
RUNNER_WORKER_QUEUE_NAME=bzy:tasks
RUNNER_WORKER_DLQ_NAME=bzy:tasks:dlq
RUNNER_WORKER_MAX_RETRIES=3
RUNNER_WORKER_RETRY_BACKOFF_SEC=5
RUNNER_WORKER_POLL_INTERVAL_MS=500
RUNNER_WORKER_TASK_TIMEOUT_SEC=300

# ── Executor ──────────────────────────────────────────────────────────────────
RUNNER_EXECUTOR_TYPE=local             # local | docker
RUNNER_EXECUTOR_DOCKER_NETWORK=bridge
RUNNER_EXECUTOR_DOCKER_MEMORY=512m
RUNNER_EXECUTOR_DOCKER_CPU=0.5
RUNNER_EXECUTOR_SANDBOX_ENABLED=false

# ── Cluster ───────────────────────────────────────────────────────────────────
RUNNER_CLUSTER_NODE_ID=               # auto-generated from hostname if empty
RUNNER_CLUSTER_HEARTBEAT_INTERVAL_SEC=10
RUNNER_CLUSTER_NODE_TTL_SEC=30

# ── Telemetry ─────────────────────────────────────────────────────────────────
RUNNER_TELEMETRY_ENABLED=false
RUNNER_TELEMETRY_OTLP_ENDPOINT=localhost:4317
RUNNER_TELEMETRY_SAMPLE_RATE=1.0
