# ── Service ───────────────────────────────────────────────────────────────────
BRAIN_ENV=development
BRAIN_SERVICE_NAME=bzy-brain
BRAIN_LOG_LEVEL=debug
BRAIN_LOG_FORMAT=console

# ── gRPC ──────────────────────────────────────────────────────────────────────
BRAIN_GRPC_ADDR=:50051

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────────
BRAIN_DATABASE_DSN=postgres://bzy:bzy_dev@localhost:5432/bzy_brain?sslmode=disable
BRAIN_DATABASE_MAX_OPEN_CONNS=25
BRAIN_DATABASE_MAX_IDLE_CONNS=5
BRAIN_DATABASE_CONN_MAX_LIFETIME=5m
BRAIN_DATABASE_MIGRATIONS_PATH=../../migrations/brain

# ── Redis ─────────────────────────────────────────────────────────────────────
BRAIN_REDIS_ADDR=localhost:6379
BRAIN_REDIS_PASSWORD=
BRAIN_REDIS_DB=0
BRAIN_REDIS_POOL_SIZE=10

# ── NATS ──────────────────────────────────────────────────────────────────────
BRAIN_NATS_URL=nats://localhost:4222
BRAIN_NATS_MAX_RECONNECT=10
BRAIN_NATS_RECONNECT_WAIT=2s

# ── AI Providers ──────────────────────────────────────────────────────────────
BRAIN_AI_DEFAULT_PROVIDER=openai

# OpenAI (or any OpenAI-compatible endpoint: Groq, Together, LiteLLM)
BRAIN_AI_OPENAI_API_KEY=sk-...
BRAIN_AI_OPENAI_BASE_URL=                        # leave empty for api.openai.com
BRAIN_AI_OPENAI_DEFAULT_MODEL=gpt-4o
BRAIN_AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BRAIN_AI_OPENAI_MAX_TOKENS=4096
BRAIN_AI_OPENAI_TEMPERATURE=0.7

# Ollama (local models — requires Ollama running)
BRAIN_AI_OLLAMA_BASE_URL=http://localhost:11434
BRAIN_AI_OLLAMA_MODEL=llama3.2

# ── Vector store ──────────────────────────────────────────────────────────────
BRAIN_VECTOR_DIMENSIONS=1536
BRAIN_VECTOR_DISTANCE_FUNC=cosine
BRAIN_VECTOR_INDEX_TYPE=hnsw

# ── Memory ────────────────────────────────────────────────────────────────────
BRAIN_MEMORY_MAX_CONTEXT_TOKENS=8000
BRAIN_MEMORY_RECENCY_WINDOW_DAYS=30
BRAIN_MEMORY_SUMMARY_THRESHOLD=20

# ── Telemetry ─────────────────────────────────────────────────────────────────
BRAIN_TELEMETRY_ENABLED=false
BRAIN_TELEMETRY_OTLP_ENDPOINT=localhost:4317
BRAIN_TELEMETRY_SAMPLE_RATE=1.0
