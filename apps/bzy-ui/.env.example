# Base URL for the bzy-interface REST API (no trailing slash)
# Defaults to same origin (proxied via Vite dev server) when omitted
VITE_API_URL=http://localhost:8080

# WebSocket URL override (ws:// or wss://)
# Derived from window.location.origin automatically when omitted
VITE_WS_URL=

# Optional: skip JWT login and authenticate via API key instead
VITE_API_KEY=
